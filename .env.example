# Database Configuration
# The REST API. This is what the application uses, through PostgREST.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Direct Postgres connection - a different credential to the same database, with
# the database password rather than an API key. Not interchangeable with the
# three above: PostgREST cannot run DDL or read information_schema.
#
# Only these use it, and none of them run in production:
#   scripts/migrate.py                          apply pending migrations
#   scripts/audit_schema_usage.py               audit columns against the schema
#   scripts/audit_schema_usage.py --emit-schema regenerate db/expected_schema.py
#
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the pooler, not db.<ref>.supabase.co - that host is IPv6-only on newer
# projects and does not resolve on an IPv4 network. Verified against this
# project: the pooler prefix is aws-1 (aws-0 answers
# "tenant/user not found"), and only port 6543 is reachable - 6543 is
# transaction mode, which handles migrate.py's DDL fine, while 5432 timed out.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Redis (Upstash)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# WhatsApp (Meta Business API)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_BUSINESS_ID=
META_WEBHOOK_VERIFY_TOKEN=vendly-webhook-secret

# LLM Provider Selection
# Options: gemini | openrouter
LLM_PROVIDER=gemini

# Gemini Configuration (Free tier available)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# OpenRouter Configuration (Qwen and other models)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-3.5b-instruct

# LLM Behavior Settings
LLM_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.7

# Bot Personality Defaults
BOT_DEFAULT_TONE=casual  # Options: formal, casual, amigable, profesional
BOT_DEFAULT_EMOJIS=true
BOT_DEFAULT_GREETING="¡Hola! 👋 Bienvenido a {store_name}"

# Email Service (Resend)
RESEND_API_KEY=

# Error Monitoring
SENTRY_DSN=

# Application Settings
APP_NAME=Vendly API
APP_VERSION=0.1.0
DEBUG=false
FRONTEND_URL=http://localhost:3000

# Cifra whatsapp_configs.access_token, el token con el que se envian mensajes en
# nombre de cada negocio. Obligatoria en produccion: sin ella el backend no
# arranca, a proposito. Generar una nueva con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde, los tokens guardados son irrecuperables y cada comerciante tendra
# que volver a conectar su WhatsApp. Guardala donde guardes SUPABASE_SECRET_KEY.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
